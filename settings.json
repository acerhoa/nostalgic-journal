{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run dist)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npx *)",
      "Read(**/*.ts)",
      "Read(**/*.tsx)",
      "Read(**/*.json)",
      "Read(**/*.css)",
      "Read(**/*.html)",
      "Read(**/*.md)",
      "Edit(src/**)",
      "Edit(*.config.*)",
      "Edit(package.json)",
      "Edit(electron-builder.yml)",
      "Edit(tsconfig*.json)",
      "Edit(.eslintrc*)",
      "Edit(tailwind.config.*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Edit(.env)",
      "Edit(.env.*)"
    ]
  },
  "model": "claude-opus-4-5",
  "cleanupPeriodDays": 30,
  "attribution": {
    "coAuthoredBy": true,
    "gitBlame": false
  },
  "env": {
    "NODE_ENV": "development"
  }
}
